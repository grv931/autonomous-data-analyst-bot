# Telegram Bot Credentials (Get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# AI / LLM Configuration
# Option 1: Google Gemini API (Recommended - Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Option 2: TDS Course AI Pipe (Student Token from aipipe.org)
AIPIPE_TOKEN=your_aipipe_jwt_token_here
AIPIPE_MODEL=gpt-5-mini

# Option 3: Direct OpenAI or Custom Endpoint
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Server & Public Telemetry Log Settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
PORT=8000
PUBLIC_BASE_URL=http://localhost:8000

# Sandbox Security & Constraints
CODE_EXEC_TIMEOUT=15
MAX_HISTORY_TURNS=10
